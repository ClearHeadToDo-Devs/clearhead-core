# Workspace work map: charters and open actions as portable tree bindings.
# Contract: every row has ?id, ?name, ?kind; roots omit ?parent and every
# bound ?parent identifies another row in this same result. The CLI attaches
# each row's data_root, against which source_file (app:file) resolves.

PREFIX app: <https://clearhead.dev/vocab/app/v1#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?id ?parent ?name ?kind ?status ?priority ?source_file ?source_line WHERE {
    {
        ?id a app:Charter ; rdfs:label ?name ; app:state ?raw_status .
        BIND("charter" AS ?kind)
        OPTIONAL { ?id app:partOf ?parent }
        OPTIONAL { ?id app:file ?source_file }
    }
    UNION
    {
        ?id a app:Action ;
            rdfs:label ?name ;
            app:state ?raw_status ;
            app:partOf ?parent .
        FILTER(?raw_status != app:Completed && ?raw_status != app:Cancelled)
        BIND("action" AS ?kind)
        OPTIONAL { ?id app:priority ?priority }
        OPTIONAL { ?id app:file ?source_file }
        OPTIONAL { ?id app:line ?source_line }
    }
    BIND(STRAFTER(STR(?raw_status), "#") AS ?status)
}
# Deterministic sibling order: priority first (1 is highest; unprioritized
# actions and all charters fall to the end via the 999 sentinel), then name as
# a stable tiebreak. The tree framer preserves this row order when grouping
# children under each parent, so a human work-map reads important-first.
ORDER BY ?kind COALESCE(?priority, 999) ?name
