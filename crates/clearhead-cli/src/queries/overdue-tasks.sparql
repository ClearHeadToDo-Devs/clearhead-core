# =============================================================================
# Query: Overdue Actions
# =============================================================================
# Purpose: Open actions that are late: their effective deadline
#          (app:lateFrom, a date's following midnight or a time itself,
#          inherited from an ancestor when they have none) has passed
# Parameters:
#   ?NOW — injected as the current instant at query time
# Returns: name, due_date, scheduled_at, state, priority
# =============================================================================

PREFIX app: <https://clearhead.dev/vocab/app/v1#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?name ?due_date ?scheduled_at ?state ?priority ?source_file ?source_line WHERE {
    ?action a app:Action ;
         rdfs:label ?name ;
         app:state ?raw_state ;
         app:lateFrom ?late_from .
    FILTER(?raw_state != app:Completed && ?raw_state != app:Cancelled)
    FILTER(?late_from <= ?NOW)
    BIND(STRAFTER(STR(?raw_state), "#") AS ?state)
    OPTIONAL { ?action app:due ?due_date }
    OPTIONAL { ?action app:plannedStart ?scheduled_at }
    OPTIONAL { ?action app:priority ?priority }
    OPTIONAL { ?action app:file ?source_file }
    OPTIONAL { ?action app:line ?source_line }
}
ORDER BY ?priority ?late_from
