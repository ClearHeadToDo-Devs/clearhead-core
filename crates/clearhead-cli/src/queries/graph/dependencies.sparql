# =============================================================================
# Graph view: dependencies
# =============================================================================
# Purpose: every action with its state, priority, what it waits on directly
# and the whole it is part of (a parent action or its charter), for the
# dependency diagram. "Directly" is its own waits: its predecessors and the
# sibling before it under ~, without the waits it inherits from its parent
# (the parent's own edge already shows those). The DOT projection draws
# app:waitsOn from the earlier work and app:partOf from the containing whole.
# Usage: clearhead query graph dependencies --format dot
# =============================================================================

PREFIX app: <https://clearhead.us/vocab/app/v1#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

CONSTRUCT {
    ?action a app:Action ;
            rdfs:label ?name ;
            app:state ?status .
    ?action app:priority ?priority .
    ?action app:waitsOn ?predecessor .
    ?predecessor a app:Action ;
                 rdfs:label ?predecessor_name ;
                 app:state ?predecessor_status .
    ?action app:partOf ?parent .
    ?charter a app:Charter ;
             rdfs:label ?charter_name .
}
WHERE {
    ?action a app:Action ;
            rdfs:label ?name ;
            app:state ?status .
    OPTIONAL { ?action app:priority ?priority }
    OPTIONAL {
        ?action app:waitsOn ?predecessor .
        FILTER NOT EXISTS { ?action app:partOf ?whole . ?whole app:waitsOn ?predecessor }
        ?predecessor a app:Action ;
                     rdfs:label ?predecessor_name ;
                     app:state ?predecessor_status .
    }
    # The whole it is part of: a parent action or its charter.
    OPTIONAL { ?action app:partOf ?parent }
    # When that whole is a charter, carry its node so the graph can group.
    OPTIONAL {
        ?action app:partOf ?charter .
        ?charter a app:Charter ;
                 rdfs:label ?charter_name .
    }
}
