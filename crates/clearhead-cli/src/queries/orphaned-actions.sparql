# =============================================================================
# Query: Unlinked Actions
# =============================================================================
# Purpose: Actions not referenced by any charter and with no parent action
# Returns: name, state
# Notes:
#   Every well-formed action is app:partOf its parent action or its charter.
#   Results here may indicate missing charter membership or import artifacts.
# =============================================================================

PREFIX app: <https://clearhead.dev/vocab/app/v1#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?name ?state ?source_file ?source_line WHERE {
    ?action a app:Action ;
         rdfs:label ?name ;
         app:state ?raw_state .
    BIND(STRAFTER(STR(?raw_state), "#") AS ?state)
    FILTER NOT EXISTS { ?action app:partOf ?whole }
    OPTIONAL { ?action app:file ?source_file }
    OPTIONAL { ?action app:line ?source_line }
}
ORDER BY ?name
