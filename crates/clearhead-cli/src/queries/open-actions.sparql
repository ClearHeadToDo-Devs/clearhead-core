# =============================================================================
# Query: Open Actions (Backlog)
# =============================================================================
# Purpose: All actions that are not complete or cancelled — full backlog view
# Returns: name, state, priority, due_date
# =============================================================================

PREFIX app: <https://clearhead.dev/vocab/app/v1#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?name ?state ?priority ?due_date WHERE {
    ?action a app:Action ;
         rdfs:label ?name ;
         app:state ?raw_state .
    FILTER(?raw_state != app:Completed && ?raw_state != app:Cancelled)
    BIND(STRAFTER(STR(?raw_state), "#") AS ?state)
    OPTIONAL { ?action app:priority ?priority }
    OPTIONAL { ?action app:due ?due_date }
    OPTIONAL { ?action app:lateFrom ?late_from }
}
ORDER BY ?priority ?late_from ?name
