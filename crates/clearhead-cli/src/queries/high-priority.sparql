# =============================================================================
# Query: High Priority Actions
# =============================================================================
# Purpose: Open actions with explicit priority, ordered lowest-number first
# Returns: name, priority, state, due_date, scheduled_at
# =============================================================================

PREFIX app: <https://clearhead.us/vocab/app/v1#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?name ?priority ?state ?due_date ?scheduled_at ?source_file ?source_line WHERE {
    ?action a app:Action ;
         rdfs:label ?name ;
         app:priority ?priority ;
         app:state ?raw_state .
    FILTER(?raw_state != app:Completed && ?raw_state != app:Cancelled)
    BIND(STRAFTER(STR(?raw_state), "#") AS ?state)
    OPTIONAL { ?action app:due ?due_date }
    OPTIONAL { ?action app:lateFrom ?late_from }
    OPTIONAL { ?action app:plannedStart ?scheduled_at }
    OPTIONAL { ?action app:file ?source_file }
    OPTIONAL { ?action app:line ?source_line }
}
ORDER BY ?priority ?late_from ?name
