# =============================================================================
# Query: Unscheduled (index)
# =============================================================================
# The date-light working view (charter: agenda-view): what could I pick up,
# given nothing on the calendar demands it? The complement of the agenda —
# an action appears when it is actionable now and *unplanned*:
#   - owning Charter and every ancestor Charter are Active
#   - open or in-progress (blocked is not actionable)
#   - first in its dependency chain: nothing it waits on is still open
#     (app:waitsOn, which includes every ancestor's waits)
#   - the lowest open child: parents with open work below are containers,
#     you act on the leaf
#   - undated in scope: no planned start or deadline on the action *or any
#     ancestor* — a child of a dated parent is planned work, not unscheduled
# Sorted by state (in progress first), priority (unset last), then name.
# Returns: index contract columns plus priority, parent and parent_name
# =============================================================================

PREFIX app: <https://clearhead.us/vocab/app/v1#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT (?action AS ?id) ?name ?status ?source_file ?source_line ?priority ?parent ?parent_name WHERE {
    ?action a app:Action ;
         rdfs:label ?name ;
         app:state ?raw_state ;
         app:file ?source_file ;
         app:line ?source_line .
    FILTER(?raw_state = app:NotStarted || ?raw_state = app:InProgress)
    ?action app:partOf* ?top .
    ?top a app:Action ; app:partOf ?owner .
    ?owner a app:Charter ; app:state app:Active .
    FILTER NOT EXISTS {
        ?owner app:partOf+ ?ancestor .
        ?ancestor app:state ?ancestor_state .
        FILTER(?ancestor_state != app:Active)
    }
    #CHARTER_FILTER#
    OPTIONAL { ?action app:priority ?priority }
    OPTIONAL { ?action app:partOf ?parent . ?parent a app:Action ; rdfs:label ?parent_name }
    FILTER NOT EXISTS {
        ?action app:partOf* ?scope .
        ?scope app:plannedStart|app:due ?when .
    }
    FILTER NOT EXISTS {
        ?action app:waitsOn ?predecessor .
        ?predecessor app:state ?pred_state .
        FILTER(?pred_state != app:Completed && ?pred_state != app:Cancelled)
    }
    FILTER NOT EXISTS {
        ?child app:partOf ?action ;
               app:state ?child_state .
        FILTER(?child_state != app:Completed && ?child_state != app:Cancelled)
    }
    BIND(STRAFTER(STR(?raw_state), "#") AS ?status)
    BIND(IF(?raw_state = app:InProgress, 0, 1) AS ?state_rank)
}
ORDER BY ?state_rank ASC(COALESCE(?priority, 99)) ?name
