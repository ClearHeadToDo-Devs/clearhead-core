# =============================================================================
# Query: Chain (index)
# =============================================================================
# Purpose: given one action, every action that must still be completed before
# it can start — walked recursively through app:waitsOn (its predecessors, the
# sibling before it under ~, and its ancestors' waits) via the `+`
# (one-or-more) property path.
# Flat and deduped — no depth/parent-in-chain column. Branches (an action
# that waits on more than one) all land in the same list.
# Only open/in-progress predecessors are returned: completed or cancelled
# ones are done: they don't block anything, so they're not part of what's
# left to do.
# Parameters:
#   ?TARGET_ACTION — substituted with the resolved action's <urn:uuid:...>
# Returns: index contract columns plus priority
# =============================================================================

PREFIX app: <https://clearhead.us/vocab/app/v1#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT DISTINCT (?required AS ?id) ?name ?status ?source_file ?source_line ?priority WHERE {
    ?TARGET_ACTION app:waitsOn+ ?required .
    ?required a app:Action ;
         rdfs:label ?name ;
         app:state ?raw_state ;
         app:file ?source_file ;
         app:line ?source_line .
    FILTER(?raw_state = app:NotStarted || ?raw_state = app:InProgress)
    OPTIONAL { ?required app:priority ?priority }
    OPTIONAL {
        ?required app:partOf* ?top .
        ?top a app:Action ; app:partOf ?owner .
        ?owner a app:Charter .
    }
    #CHARTER_FILTER#
    BIND(STRAFTER(STR(?raw_state), "#") AS ?status)
}
ORDER BY ASC(COALESCE(?priority, 99)) ?name
