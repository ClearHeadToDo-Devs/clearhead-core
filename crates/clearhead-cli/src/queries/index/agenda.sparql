# =============================================================================
# Query: Agenda (index)
# =============================================================================
# The daily "just do it" list (charter: agenda-view). An action appears when
# it is actionable *now*:
#   - owning Charter and every ancestor Charter are Active
#   - open or in-progress (blocked belongs to the weekly horizon)
#   - first in its dependency chain: nothing it waits on is still open
#     (app:waitsOn: its predecessors, the sibling before it under ~, and
#     every ancestor's waits)
#   - the lowest open child: parents with open work below are containers,
#     you act on the leaf
#   - planned or late by the end of today (includes overdue), comparing the
#     derived instants app:plannedFrom and app:lateFrom (the effective
#     deadline, so an inherited one counts); undated items never appear
# Sorted by state (in progress first), priority (unset last), then the
# deadline, the planned start and name.
# Parameters:
#   ?END_OF_TODAY — the viewer's next midnight, the first instant of tomorrow
# Returns: index contract columns plus priority, scheduled_at and due_date
#          (as written), parent and parent_name
# =============================================================================

PREFIX app: <https://clearhead.us/vocab/app/v1#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT (?action AS ?id) ?name ?status ?source_file ?source_line ?priority ?scheduled_at ?due_date ?parent ?parent_name WHERE {
    ?action a app:Action ;
         rdfs:label ?name ;
         app:state ?raw_state ;
         app:file ?source_file ;
         app:line ?source_line .
    FILTER(?raw_state = app:NotStarted || ?raw_state = app:InProgress)
    # The owning Charter: the one its top-level action is part of.
    ?action app:partOf* ?top .
    ?top a app:Action ; app:partOf ?owner .
    ?owner a app:Charter ; app:state app:Active .
    FILTER NOT EXISTS {
        ?owner app:partOf+ ?ancestor .
        ?ancestor app:state ?ancestor_state .
        FILTER(?ancestor_state != app:Active)
    }
    #CHARTER_FILTER#
    OPTIONAL { ?action app:plannedStart ?scheduled_at ; app:plannedFrom ?planned_from }
    OPTIONAL { ?action app:due ?due_date }
    OPTIONAL { ?action app:lateFrom ?late_from }
    OPTIONAL { ?action app:priority ?priority }
    # The denormalized parent edge is a parent *action*, not the charter a
    # top-level action is part of ("unset for root actions").
    OPTIONAL { ?action app:partOf ?parent . ?parent a app:Action ; rdfs:label ?parent_name }
    FILTER NOT EXISTS {
        ?action app:waitsOn ?predecessor .
        ?predecessor app:state ?pred_state .
        FILTER(?pred_state != app:Completed && ?pred_state != app:Cancelled)
    }
    FILTER NOT EXISTS {
        ?child app:partOf ?action ;
               app:state ?child_state .
        FILTER(?child_state != app:Completed && ?child_state != app:Cancelled)
    }
    FILTER(
        (BOUND(?planned_from) && ?planned_from < ?END_OF_TODAY) ||
        (BOUND(?late_from) && ?late_from <= ?END_OF_TODAY)
    )
    BIND(STRAFTER(STR(?raw_state), "#") AS ?status)
    BIND(IF(?raw_state = app:InProgress, 0, 1) AS ?state_rank)
}
ORDER BY ?state_rank ASC(COALESCE(?priority, 99)) ?late_from ?planned_from ?name
