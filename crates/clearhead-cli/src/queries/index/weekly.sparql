# =============================================================================
# Query: Weekly (index)
# =============================================================================
# The horizon view (charter: agenda-view): what's coming in the next seven
# days, so dependency chains are visible before they're due. Deliberately
# wider than the daily agenda on every axis:
#   - includes blocked (waiting is part of the horizon)
#   - includes undated open work (no planned start or deadline of its own;
#     it still needs a decision)
#   - no dependency or leaf filtering — seeing the chains is the point
# Dated work appears when planned or late within the week, comparing the
# derived instants app:plannedFrom and app:lateFrom (the effective deadline).
# Sorted by the effective date (deadline, else planned start; undated last),
# then priority, then name.
# Parameters:
#   ?END_OF_WEEK — the viewer's midnight seven days after tomorrow's
# Returns: index contract columns plus priority, scheduled_at and due_date
#          (as written)
# =============================================================================

PREFIX app: <https://clearhead.us/vocab/app/v1#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT (?action AS ?id) ?name ?status ?source_file ?source_line ?priority ?scheduled_at ?due_date WHERE {
    ?action a app:Action ;
         rdfs:label ?name ;
         app:state ?raw_state ;
         app:file ?source_file ;
         app:line ?source_line .
    FILTER(?raw_state != app:Completed && ?raw_state != app:Cancelled)
    OPTIONAL { ?action app:plannedStart ?scheduled_at ; app:plannedFrom ?planned_from }
    OPTIONAL { ?action app:due ?due_date }
    OPTIONAL { ?action app:lateFrom ?late_from }
    OPTIONAL { ?action app:priority ?priority }
    OPTIONAL {
        ?action app:partOf* ?top .
        ?top a app:Action ; app:partOf ?owner .
        ?owner a app:Charter .
    }
    #CHARTER_FILTER#
    FILTER(
        (!BOUND(?scheduled_at) && !BOUND(?due_date)) ||
        (BOUND(?planned_from) && ?planned_from < ?END_OF_WEEK) ||
        (BOUND(?late_from) && ?late_from <= ?END_OF_WEEK)
    )
    BIND(STRAFTER(STR(?raw_state), "#") AS ?status)
}
ORDER BY ASC(COALESCE(?late_from, ?planned_from, "9999-12-31T23:59:59Z"^^xsd:dateTime)) ASC(COALESCE(?priority, 99)) ?name
