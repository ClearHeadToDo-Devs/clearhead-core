# =============================================================================
# Query: Default Index
# =============================================================================
# Purpose: All open actions with source locations — the default index view.
#          The CLI attaches each row's data_root, so the consumer can resolve
#          source_file (app:file, relative to the data root) without external
#          context.
# Returns: index contract columns (id, name, status, source_file, source_line;
#          data_root attached)
# Ordered by workspace, then file and line.
# =============================================================================

PREFIX app: <https://clearhead.us/vocab/app/v1#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT (?action AS ?id) ?name ?status ?source_file ?source_line WHERE {
    GRAPH ?workspace {
        ?action a app:Action ;
             rdfs:label ?name ;
             app:state ?raw_state ;
             app:file ?source_file ;
             app:line ?source_line .
    }
    FILTER(?raw_state != app:Completed && ?raw_state != app:Cancelled)
    OPTIONAL {
        ?action app:partOf* ?top .
        ?top a app:Action ; app:partOf ?owner .
        ?owner a app:Charter .
    }
    #CHARTER_FILTER#
    BIND(STRAFTER(STR(?raw_state), "#") AS ?status)
}
ORDER BY ?workspace ?source_file ?source_line
