# =============================================================================
# Query: Actions by Status
# =============================================================================
# Purpose: Filter Actions by execution status
# Parameters:
#   ?STATUS_FILTER — pass via --status flag:
#     NotStarted | InProgress | Blocked | Completed | Cancelled
#     (an app: prefix is optional)
# Returns: name, state, scheduled_at, completion_date
# =============================================================================

PREFIX app: <https://clearhead.dev/vocab/app/v1#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?name ?state ?scheduled_at ?completion_date ?source_file ?source_line WHERE {
    ?action a app:Action ;
         rdfs:label ?name ;
         app:state ?raw_state .

    FILTER(?raw_state = ?STATUS_FILTER)
    BIND(STRAFTER(STR(?raw_state), "#") AS ?state)

    OPTIONAL { ?action app:plannedStart ?scheduled_at }
    OPTIONAL { ?action app:closed ?completion_date }
    OPTIONAL { ?action app:file ?source_file }
    OPTIONAL { ?action app:line ?source_line }
}
ORDER BY ?name
