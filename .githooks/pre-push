#!/bin/sh
#
# Pre-push gate for the ClearHead Rust workspace: refuse to push unless every
# member crate is formatted, lint-clean, and green. The checks live in
# scripts/gate.sh, the single definition shared with anyone running the gate by
# hand; CI re-runs the same checks in a clean environment as the source of
# truth. Bypass in a genuine emergency with:
#   git push --no-verify
#
set -eu
exec sh "$(dirname "$0")/../scripts/gate.sh"
