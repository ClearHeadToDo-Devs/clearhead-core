#!/bin/sh
#
# Pre-push gate for the ClearHead Rust workspace: refuse to push unless every
# member crate is formatted, lint-clean, and green. This is the local half of
# the tech-debt #2 quality baseline; CI re-runs the same checks in a clean
# environment as the source of truth. Bypass in a genuine emergency with:
#   git push --no-verify
#
set -eu

echo "pre-push > cargo fmt --all --check"
cargo fmt --all --check

echo "pre-push > cargo clippy --workspace --all-targets -- -D warnings"
cargo clippy --workspace --all-targets --no-deps -- -D warnings

echo "pre-push > cargo test --workspace"
cargo test --workspace --quiet

echo "pre-push > cargo check -p clearhead_core --no-default-features (portable capability set)"
cargo check -p clearhead_core --no-default-features

echo "pre-push > cargo check -p clearhead_cli --no-default-features (minimal, query-engine-free profile)"
cargo check -p clearhead_cli --no-default-features
# The rdf-publication charter: Oxigraph may only ever enter through the CLI's
# optional `sparql` feature — never the minimal profile's dependency graph.
if cargo tree -p clearhead_cli --no-default-features -e normal --prefix none | grep -q '^oxigraph '; then
  echo "pre-push > FAIL: oxigraph appears in the minimal CLI dependency graph" >&2
  echo "pre-push > the query engine belongs only to the optional \`sparql\` feature." >&2
  exit 1
fi

echo "pre-push > pure Core source gate"
sh scripts/pure-core-source-gate.sh

echo "pre-push > wasm dependency gate"
sh scripts/wasm-dependency-gate.sh

echo "pre-push > all checks passed"
